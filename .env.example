# Public
SITE_URL=https://www.savethreadsvideos.com
# Production default: self-hosted open-source extraction. No paid key needed.
MEDIA_RESOLVER_PROVIDER=opensource
RESOLVE_CACHE_TTL=300
# Optional public support address shown on /contact. Leave empty to use the form only.
CONTACT_EMAIL=
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=
ANALYTICS_ID=
ADS_ENABLED=false
# --- Admin / Supabase (local dev via `npx supabase start`, requires Docker) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Admin login email for local seed (password is set in Studio, never committed)
ADMIN_EMAIL=admin@example.com
# --- Optional paid external resolver (NOT required; opensource is the default) ---
# Only needed if you explicitly choose MEDIA_RESOLVER_PROVIDER=external.
# MEDIA_RESOLVER_API_URL=
# MEDIA_RESOLVER_API_KEY=
# --- AI content drafts (free Gemini tier) — optional ---
# The API key can also be stored from the admin UI (masked, DB-backed).
# A secret here takes precedence over the admin-UI key.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AQ.Ab8...  (current Auth-key format; legacy AIza... also accepted)
# GEMINI_MODEL=gemini-2.5-flash
# --- Production secrets (never commit; use `wrangler secret put`) ---
# SUPABASE_URL / SUPABASE_SERVICE_KEY / SUPABASE_ANON_KEY / IP_HASH_SALT
# (admin dashboard database; unrelated to media resolution)
